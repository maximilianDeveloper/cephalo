# System files
.DS_Store
Thumbs.db
desktop.ini

# Temporary Office files
~$*.docx
~$*.pptx
~$*.xlsx
~WRL*.tmp
.~lock.*#

# Editor directories
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.pyc
.venv/
venv/

# Research data — never commit it: raw data may carry personal identifiers
**/data/raw/*
**/data/processed/*

# Keep placeholders
!**/data/raw/.gitkeep
!**/data/raw/README.md
!**/data/processed/.gitkeep

# Scratch files of the agents (they delete them before a chat ends)
_scratch/

# Claude Code runtime artifacts (in every folder: in a multi-project
# setup, Claude Code is opened on a sub-project)
**/.claude/worktrees/
**/.claude/settings.local.json
