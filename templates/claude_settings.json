{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; f=\"$d/scripts/cephalo_guard.sh\"; [ -f \"$f\" ] || f=\"$d/../scripts/cephalo_guard.sh\"; [ -f \"$f\" ] && sh \"$f\"; exit 0",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; f=\"$d/scripts/cephalo_guard.sh\"; [ -f \"$f\" ] || f=\"$d/../scripts/cephalo_guard.sh\"; [ -f \"$f\" ] && sh \"$f\"; exit 0",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
